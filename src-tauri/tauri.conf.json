{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local CV Builder",
  "version": "0.1.0",
  "identifier": "com.teems.local-cv-builder",
  "build": {
    "beforeDevCommand": "cmd /C call scripts\\start-vite.cmd",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cmd /C call scripts\\build-frontend.cmd",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local CV Builder",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
